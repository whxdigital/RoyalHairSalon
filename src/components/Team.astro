---
const barbers = [
  {
    name: 'Marco Silva',
    role: 'Fundador & Master Barber',
    specialty: 'Skin Fade Milimétrico & Visagismo Facial',
    experience: '12 Anos de Experiência',
    image: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80',
    badge: 'Mestre Barbeiro'
  },
  {
    name: 'David Santos',
    role: 'Fade Specialist & Hair Stylist',
    specialty: 'Low Fade, Textured Crop & Freestyle Hair Art',
    experience: '8 Anos de Experiência',
    image: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=600&q=80',
    badge: 'Especialista Fade'
  },
  {
    name: 'Rafael Oliveira',
    role: 'Senior Beard Groomer',
    specialty: 'Barboterapia com Toalha Quente & Alinhamento à Navalha',
    experience: '7 Anos de Experiência',
    image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=600&q=80',
    badge: 'Especialista Barba'
  }
];
---

<section id="team" class="py-24 relative overflow-hidden bg-neutral-950/80 border-t border-neutral-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-widest mb-3">
        <span>A Nossa Equipa</span>
      </div>
      <h2 class="font-royal text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">
        Mestres das <span class="text-gold-gradient">Tesouras & Lâminas</span>
      </h2>
      <p class="text-neutral-400 text-sm sm:text-base">
        Profissionais certificados com anos de aperfeiçoamento contínuo nas técnicas de corte mais avançadas da Europa.
      </p>
    </div>

    <!-- Barbers Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {barbers.map((barber) => (
        <div class="glass-panel rounded-2xl overflow-hidden group hover:border-amber-400/50 transition-all duration-300 flex flex-col justify-between">
          <div class="relative h-80 overflow-hidden">
            <img 
              src={barber.image} 
              alt={barber.name} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 filter grayscale-[25%] group-hover:grayscale-0" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/20 to-transparent"></div>
            
            <span class="absolute top-4 right-4 px-3 py-1 rounded-full bg-black/80 backdrop-blur-md border border-amber-500/30 text-amber-300 text-[10px] font-bold uppercase tracking-wider">
              {barber.badge}
            </span>

            <div class="absolute bottom-4 left-4 right-4">
              <span class="text-[11px] font-semibold text-amber-400 tracking-wider uppercase block">{barber.experience}</span>
              <h3 class="font-royal text-xl font-bold text-white mt-0.5">{barber.name}</h3>
              <p class="text-xs text-neutral-300">{barber.role}</p>
            </div>
          </div>

          <div class="p-6 flex-1 flex flex-col justify-between">
            <div class="mb-6">
              <span class="text-[10px] uppercase font-bold text-neutral-400 tracking-wider block mb-1">Especialidade Principal</span>
              <p class="text-xs text-neutral-300 leading-relaxed font-medium">
                {barber.specialty}
              </p>
            </div>

            <button 
              class="open-booking-modal w-full py-3 rounded-xl bg-neutral-900 border border-neutral-800 text-neutral-200 hover:border-amber-400 hover:text-amber-300 font-bold text-xs uppercase tracking-wider transition-all cursor-pointer text-center"
            >
              Agendar com {barber.name.split(' ')[0]}
            </button>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
