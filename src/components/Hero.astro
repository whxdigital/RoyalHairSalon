---
---

<section id="hero" class="relative min-h-[92vh] sm:min-h-screen flex items-center pt-24 pb-16 overflow-hidden bg-[#0A0A0A]">
  <!-- Interactive Hair & Scissor Particles Canvas -->
  <canvas id="hairCuttingCanvas" class="absolute inset-0 w-full h-full pointer-events-none z-0"></canvas>

  <!-- Studio Lighting Glows -->
  <div class="absolute -top-32 left-1/4 w-96 h-96 bg-[#FF6B00]/15 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute bottom-10 right-10 w-[32rem] h-[32rem] bg-[#FF6B00]/10 rounded-full blur-[160px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10 w-full">
    <!-- Asymmetrical Split-Screen Layout (7 cols / 5 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Hero Left: Content & SEO Copy (7 cols) -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <!-- Live Status Pill Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#121214] border border-[#FF6B00]/30 text-white text-[11px] sm:text-xs font-semibold tracking-wider uppercase backdrop-blur-md shadow-[0_0_20px_rgba(255,107,0,0.2)]">
          <span class="w-2 h-2 rounded-full bg-[#FF6B00] animate-pulse"></span>
          <span class="text-[#FF8533]">Rua Alves Redol 10A, Odivelas</span>
          <span class="text-neutral-600">•</span>
          <span class="text-neutral-300">Aberto Agora</span>
        </div>

        <!-- Local SEO Headline (Heavy Bold Geometric Sans-Serif) -->
        <h1 id="transHeroTitle" class="font-royal text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold leading-[1.08] text-white tracking-tight">
          A Arte do Corte & <br class="hidden sm:inline" />
          <span class="text-orange-gradient">Barbearia em Odivelas</span>
        </h1>

        <!-- Subheadline -->
        <p id="transHeroSub" class="text-neutral-400 text-sm sm:text-base lg:text-lg leading-relaxed max-w-2xl mx-auto lg:mx-0">
          Cortes de precisão arquitetónica, skin fade milimétrico, barboterapia com toalha quente e atendimento VIP na <strong class="text-white font-semibold">Rua Alves Redol 10A</strong>. O padrão supremo de grooming masculino às portas de Lisboa.
        </p>

        <!-- Direct Instant Contact Bar -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5 sm:gap-3 pt-1">
          <a 
            href="tel:+351939558041" 
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[#121214] border border-white/10 text-neutral-300 hover:border-[#FF6B00] hover:text-white transition-all text-xs font-semibold shadow-md"
            title="Ligar para +351 939 558 041"
          >
            <span>📞</span>
            <span class="font-mono">+351 939 558 041</span>
          </a>

          <a 
            href="tel:+351920206618" 
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[#121214] border border-white/10 text-neutral-300 hover:border-[#FF6B00] hover:text-white transition-all text-xs font-semibold shadow-md"
            title="Ligar para +351 920 206 618"
          >
            <span>📞</span>
            <span class="font-mono">+351 920 206 618</span>
          </a>

          <a 
            href="https://wa.me/351939558041" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-emerald-950/60 border border-emerald-500/40 text-emerald-400 hover:text-white hover:bg-emerald-900/80 transition-all text-xs font-semibold shadow-md"
            title="Agendar via WhatsApp"
          >
            <span>💬</span>
            <span>WhatsApp</span>
          </a>
        </div>

        <!-- Rating Highlight -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 sm:gap-4 pt-1">
          <div class="flex items-center gap-1.5">
            <span class="font-bold text-white text-base sm:text-lg">4.9</span>
            <div class="flex text-[#FF6B00] text-xs sm:text-sm">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            </div>
          </div>
          <span class="text-xs text-neutral-400 border-l border-neutral-800 pl-3 sm:pl-4">
            Mais de <strong class="text-white font-medium">250+ avaliações 5 estrelas</strong> no Google
          </span>
          <a href="https://share.google/2O3L2FtG55BM0sQ7y" target="_blank" rel="noopener noreferrer" class="text-xs text-[#FF8533] hover:text-white underline underline-offset-4 transition-colors font-medium">
            Ver Avaliações ↗
          </a>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 sm:gap-4 pt-3">
          <button class="open-booking-modal w-full sm:w-auto btn-brand-orange px-8 py-4 rounded-xl text-xs sm:text-sm font-bold tracking-wider uppercase cursor-pointer flex items-center justify-center gap-2 group shadow-xl">
            <span>Agendar Horário Online</span>
            <svg width="16" height="16" style="width: 16px; height: 16px; max-width: 16px;" class="transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>

          <a href="#services" class="w-full sm:w-auto btn-outline-orange px-7 py-4 rounded-xl text-xs sm:text-sm font-semibold tracking-wider text-center transition-all">
            Ver Todos os Serviços
          </a>

          <!-- Interactive Cut Trigger Button -->
          <button id="testCutHeroBtn" class="px-4 py-3.5 rounded-xl bg-[#121214] border border-[#FF6B00]/40 text-[#FF8533] hover:text-white hover:border-[#FF6B00] transition-all text-xs font-semibold flex items-center gap-2 cursor-pointer shadow-lg active:scale-95" title="Clique para cortar fios interativamente">
            <span>✂️</span>
            <span>Testar Corte</span>
          </button>
        </div>

        <!-- Trust Features Checklist -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3 pt-5 border-t border-neutral-800 text-[11px] sm:text-xs text-neutral-400">
          <div class="flex items-center gap-2">
            <span class="text-[#FF6B00] font-bold">✓</span>
            <span>Sem tempo de espera</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#FF6B00] font-bold">✓</span>
            <span>Toalha quente inclusa</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#FF6B00] font-bold">✓</span>
            <span>Estacionamento próximo</span>
          </div>
        </div>
      </div>

      <!-- Hero Right: Luxury Barber Chair Lifestyle Visual & Floating Badges (5 cols) -->
      <div class="lg:col-span-5 relative mt-6 lg:mt-0 flex justify-center">
        <!-- SaaS Container Frame with Studio Lighting -->
        <div class="relative w-full max-w-md lg:max-w-none rounded-3xl overflow-hidden border border-white/15 bg-[#121214] shadow-[0_25px_60px_-15px_rgba(0,0,0,0.9),0_0_35px_-5px_rgba(255,107,0,0.25)] group">
          
          <!-- High-End Luxury Barber Chair Lifestyle Image -->
          <div class="relative aspect-[4/5] sm:aspect-square lg:aspect-[4/5] w-full overflow-hidden">
            <img 
              src="https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=1200&q=80" 
              alt="Cadeira de Barbeiro Vintage de Luxo no Royal Hair Salon Odivelas" 
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 select-none"
              loading="eager"
            />
            <!-- Atmospheric Gradient Vignette -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A0A] via-[#0A0A0A]/30 to-transparent"></div>
            <div class="absolute inset-0 ring-1 ring-inset ring-white/10 rounded-3xl pointer-events-none"></div>
          </div>

          <!-- Top-Left Floating Badge: Location -->
          <div class="absolute top-4 left-4 glass-panel px-3.5 py-2 rounded-xl flex items-center gap-2 shadow-xl border border-white/10">
            <span class="text-[#FF6B00] text-xs">📍</span>
            <div class="text-left">
              <div class="text-[10px] font-bold text-white uppercase tracking-wider">Odivelas • Lisboa</div>
              <div class="text-[9px] text-neutral-400">Rua Alves Redol 10A</div>
            </div>
          </div>

          <!-- Top-Right Floating Live Badge: Rating -->
          <div class="absolute top-4 right-4 glass-panel px-3 py-1.5 rounded-xl flex items-center gap-1.5 shadow-xl border border-white/10">
            <span class="text-[#FF6B00] font-bold text-xs">★ 4.9</span>
            <span class="text-[10px] text-neutral-300 font-medium">Google VIP</span>
          </div>

          <!-- Bottom Floating VIP Button (Corte & Fade VIP) -->
          <button 
            type="button" 
            class="open-booking-modal absolute bottom-4 left-4 right-4 glass-panel p-3.5 rounded-2xl flex items-center justify-between shadow-2xl hover:border-[#FF6B00] hover:scale-[1.02] active:scale-95 transition-all duration-300 cursor-pointer group/btn text-left border border-[#FF6B00]/40 bg-[#0A0A0A]/90 backdrop-blur-xl" 
            data-service="Corte Royal & Skin Fade de Precisão"
            title="Agendar Corte & Fade VIP com Precisão ao Milímetro"
          >
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-[#FF6B00]/20 text-[#FF6B00] flex items-center justify-center font-bold text-base group-hover/btn:scale-110 group-hover/btn:bg-[#FF6B00]/30 transition-all shadow-[0_0_15px_rgba(255,107,0,0.3)]">
                ✂️
              </div>
              <div>
                <div class="text-xs font-extrabold text-white uppercase tracking-wider group-hover/btn:text-[#FF8533] transition-colors">Corte & Fade VIP</div>
                <div class="text-[10px] text-[#FF8533] font-medium">Precisão ao Milímetro • Vagas Hoje</div>
              </div>
            </div>
            <div class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-xs text-white group-hover/btn:bg-[#FF6B00] group-hover/btn:text-white transition-all">
              ➔
            </div>
          </button>

        </div>
      </div>

    </div>
  </div>
</section>
