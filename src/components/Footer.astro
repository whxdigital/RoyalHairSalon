<footer class="bg-black border-t border-neutral-900 pt-16 pb-28 sm:pb-16 text-neutral-400 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-neutral-900">
      
