      <!-- Quick Links -->
      <div>
        <h4 class="font-royal font-bold text-white uppercase tracking-wider text-xs mb-4">Navegação Rápida</h4>
        <ul class="space-y-2.5">
          <li><a href="#services" class="hover:text-amber-400 transition-colors">Serviços de Corte & Barbear</a></li>
          <li><a href="#transformacao" class="hover:text-amber-400 transition-colors">Transformação Fade</a></li>
          <li><a href="#gallery" class="hover:text-amber-400 transition-colors">Galeria de Cortes</a></li>
        </ul>
      </div>

      <!-- Services List -->
      <div>
        <h4 class="font-royal font-bold text-white uppercase tracking-wider text-xs mb-4">Rituais de Corte</h4>
        <ul class="space-y-2.5">
          <li><span class="text-neutral-300">Skin Fade & Taper Fade de Precisão</span></li>
          <li><span class="text-neutral-300">Corte Clássico à Tesoura</span></li>
          <li><span class="text-neutral-300">Corte Júnior Infantil</span></li>
          <li><span class="text-neutral-300">Barboterapia com Toalha Quente</span></li>
          <li><span class="text-neutral-300">Alinhamento & Escultura de Barba</span></li>
          <li><span class="text-neutral-300">Camuflagem de Cabelos Brancos</span></li>
          <li><span class="text-neutral-300">Spa de Couro Cabeludo & Lavagem</span></li>
        </ul>
      </div>

      <!-- Address & Info -->
