---
---

<section id="location" class="py-24 relative overflow-hidden bg-[#07080b] border-t border-neutral-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-widest mb-3">
        <span>Onde Estamos & Contactos</span>
      </div>
      <h2 class="font-royal text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">
        Localização & <span class="text-gold-gradient">Citação Oficial GMB</span>
      </h2>
      <p class="text-neutral-400 text-sm sm:text-base">
        Localização central na Rua Alves Redol 10A em Odivelas, com facilidade de estacionamento e transportes públicos.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Left: Contact Details & Operating Hours Card -->
      <div class="lg:col-span-5 flex flex-col justify-between glass-panel p-6 sm:p-8 rounded-2xl border border-amber-500/20 space-y-6">
        
        <div>
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-neutral-800">
            <h3 class="font-royal text-xl font-bold text-white flex items-center gap-2">
              <span class="text-amber-400">📍</span>
              <span>Royal Hair Salon Odivelas</span>
            </h3>
            <span class="px-2.5 py-1 rounded-full text-[10px] bg-emerald-500/20 text-emerald-400 font-bold uppercase tracking-wider">
              GMB Verificado
            </span>
          </div>

          <!-- Address & Citation Data -->
          <div class="space-y-4 text-sm text-neutral-300">
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-xl bg-neutral-900 border border-neutral-800 flex items-center justify-center text-amber-400 shrink-0 mt-0.5 shadow-md">
                🏛️
              </div>
              <div>
                <strong class="text-white block font-semibold text-xs uppercase tracking-wider text-amber-400/90">Morada Oficial (NAP):</strong>
                <span class="text-sm text-white font-medium block">Rua Alves Redol 10A</span>
                <span class="text-xs text-neutral-400 block">2675-284 Odivelas, Portugal (Grande Lisboa)</span>
                <span class="text-[11px] text-neutral-500 block mt-0.5">Coordenadas: 38.7925° N, -9.1824° W</span>
              </div>
            </div>

            <!-- Real Telephones -->
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-xl bg-neutral-900 border border-neutral-800 flex items-center justify-center text-amber-400 shrink-0 mt-0.5 shadow-md">
                📞
              </div>
              <div class="space-y-1">
                <strong class="text-white block font-semibold text-xs uppercase tracking-wider text-amber-400/90">Telefones Diretos / Marcações:</strong>
                <div class="flex flex-col sm:flex-row gap-2 pt-0.5">
                  <a href="tel:+351939558041" class="text-amber-300 hover:text-white transition-colors font-mono font-bold text-xs bg-neutral-900/80 px-2.5 py-1 rounded-lg border border-amber-500/20">
                    +351 939 558 041
                  </a>
                  <a href="tel:+351920206618" class="text-amber-300 hover:text-white transition-colors font-mono font-bold text-xs bg-neutral-900/80 px-2.5 py-1 rounded-lg border border-amber-500/20">
                    +351 920 206 618
                  </a>
                </div>
              </div>
            </div>

            <!-- WhatsApp -->
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-xl bg-emerald-950/80 border border-emerald-500/40 flex items-center justify-center text-emerald-400 shrink-0 mt-0.5 shadow-md">
                💬
              </div>
              <div>
                <strong class="text-white block font-semibold text-xs uppercase tracking-wider text-emerald-400">WhatsApp Oficial:</strong>
                <a href="https://wa.me/351939558041" target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300 transition-colors text-xs font-semibold block mt-0.5">
                  +351 939 558 041 (Atendimento & Marcações Rápidas) ↗
                </a>
              </div>
            </div>

            <!-- Coverage Entities -->
            <div class="pt-2">
              <span class="text-[11px] text-neutral-400 block font-semibold mb-1">Áreas Locais de Atendimento:</span>
              <div class="flex flex-wrap gap-1.5 text-[10px] text-neutral-300">
                <span class="px-2 py-0.5 rounded bg-neutral-900 border border-neutral-800">Odivelas Centro</span>
                <span class="px-2 py-0.5 rounded bg-neutral-900 border border-neutral-800">Colinas do Cruzeiro</span>
                <span class="px-2 py-0.5 rounded bg-neutral-900 border border-neutral-800">Ramada</span>
                <span class="px-2 py-0.5 rounded bg-neutral-900 border border-neutral-800">Caneças</span>
                <span class="px-2 py-0.5 rounded bg-neutral-900 border border-neutral-800">Póvoa de Sto. Adrião</span>
                <span class="px-2 py-0.5 rounded bg-neutral-900 border border-neutral-800">Pontinha</span>
                <span class="px-2 py-0.5 rounded bg-neutral-900 border border-neutral-800">Lisboa</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Operating Hours Schedule -->
        <div class="p-4 sm:p-5 rounded-xl bg-neutral-900/90 border border-neutral-800">
          <h4 class="font-royal text-xs font-bold text-white mb-2.5 flex items-center justify-between">
            <span>⏰ Horário de Atendimento</span>
            <span class="px-2 py-0.5 rounded text-[9px] bg-emerald-500/20 text-emerald-400 font-bold uppercase">Aberto Hoje</span>
          </h4>
          
          <div class="space-y-1.5 text-xs">
            <div class="flex justify-between py-1 border-b border-neutral-800">
              <span class="text-neutral-400">Segunda a Sexta:</span>
              <span class="font-bold text-white">09:30 – 20:00</span>
            </div>
            <div class="flex justify-between py-1 border-b border-neutral-800">
              <span class="text-neutral-400">Sábado:</span>
              <span class="font-bold text-white">09:00 – 19:30</span>
            </div>
            <div class="flex justify-between py-1 text-red-400 font-medium">
              <span>Domingo:</span>
              <span>Encerrado (Descanso semanal)</span>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="grid grid-cols-2 gap-3 pt-1">
          <a 
            href="https://maps.google.com/?q=Rua+Alves+Redol+10A+2675-284+Odivelas" 
            target="_blank" 
            rel="noopener noreferrer"
            class="btn-royal-gold py-3 px-3 sm:px-4 rounded-xl text-center text-xs font-bold uppercase tracking-wider flex items-center justify-center gap-1.5 shadow-md"
          >
            <span>Como Chegar</span>
            <span>↗</span>
          </a>
          <button 
            class="open-booking-modal btn-outline-gold py-3 px-3 sm:px-4 rounded-xl text-center text-xs font-bold uppercase tracking-wider cursor-pointer"
          >
            Agendar Horário
          </button>
        </div>

      </div>

      <!-- Right: Interactive Google Map Embed & Citation Card -->
      <div class="lg:col-span-7 rounded-2xl overflow-hidden glass-panel border border-neutral-800 min-h-[440px] relative shadow-2xl flex flex-col">
        <!-- Live GMB Header Bar -->
        <div class="p-4 bg-neutral-900/95 border-b border-neutral-800 flex flex-wrap items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2.5 text-neutral-300">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
            <span class="font-semibold text-white">Rua Alves Redol 10A, Odivelas</span>
            <span class="text-neutral-500">•</span>
            <span class="text-amber-400">4.9 ★ (250+ Avaliações)</span>
          </div>
          <a 
            href="https://share.google/2O3L2FtG55BM0sQ7y" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-neutral-800 text-amber-300 hover:text-white hover:bg-neutral-700 transition-colors font-bold text-xs"
          >
            <span>Ver no Google Perfil / Maps</span>
            <span>↗</span>
          </a>
        </div>

        <!-- Google Map Iframe -->
        <iframe 
          title="Localização e Perfil Google My Business do Royal Hair Salon em Odivelas"
          src="https://maps.google.com/maps?q=Rua+Alves+Redol+10A,+Odivelas,+Portugal&t=&z=16&ie=UTF8&iwloc=&output=embed" 
          class="w-full flex-1 border-0 min-h-[360px] filter invert-[90%] hue-rotate-180 contrast-125"
          loading="lazy"
          allowfullscreen=""
          aria-label="Mapa de Localização do Royal Hair Salon na Rua Alves Redol 10A em Odivelas"
        ></iframe>

        <!-- Footer Map Citation Strip -->
        <div class="p-3 bg-neutral-950/90 border-t border-neutral-800 text-[11px] text-neutral-400 flex flex-wrap items-center justify-between gap-2">
          <span>🚇 A 5 min da Estação de Metro de Odivelas (Linha Amarela)</span>
          <a href="https://maps.google.com/?q=Rua+Alves+Redol+10A+2675-284+Odivelas" target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:underline">
            Obter Itinerário GPS ↗
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
