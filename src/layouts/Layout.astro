    <!-- Complete Inline Safety CSS -->
    <style is:global>
      :root {
        --gold-primary: #d4af37;
        --gold-light: #f6e27a;
        --gold-dark: #aa771c;
        --gold-gradient: linear-gradient(135deg, #f6e27a 0%, #d4af37 50%, #aa771c 100%);
        --gold-glow: rgba(212, 175, 55, 0.35);
        --bg-deep: #07080b;
        --bg-card: rgba(14, 16, 23, 0.82);
        --border-subtle: rgba(212, 175, 55, 0.18);
        --border-active: rgba(212, 175, 55, 0.6);
      }

      /* Global SVG Protection */
      svg {
        max-width: 100%;
        box-sizing: border-box;
      }

      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: #07080b; }
      ::-webkit-scrollbar-thumb { background: #262938; border-radius: 4px; border: 1px solid rgba(212, 175, 55, 0.2); }
      ::-webkit-scrollbar-thumb:hover { background: #d4af37; }

      .font-royal { font-family: 'Cinzel', serif; letter-spacing: 0.05em; }
      .font-display { font-family: 'Syne', sans-serif; }
      .font-body { font-family: 'Plus Jakarta Sans', sans-serif; }

      .text-gold-gradient {
        background: linear-gradient(135deg, #ffffff 0%, #f6e27a 35%, #d4af37 70%, #aa771c 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .glass-panel {
        background: var(--bg-card);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--border-subtle);
        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .glass-panel:hover {
        border-color: var(--border-active);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.8), 0 0 20px -5px var(--gold-glow);
      }

      .btn-royal-gold {
        position: relative;
        background: var(--gold-gradient);
        color: #07080b;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        border: none;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(212, 175, 55, 0.35);
        transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
      }
      .btn-royal-gold::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -60%;
        width: 40%;
        height: 200%;
        background: linear-gradient(
          90deg,
          rgba(255, 255, 255, 0) 0%,
          rgba(255, 255, 255, 0.6) 50%,
          rgba(255, 255, 255, 0) 100%
        );
        transform: rotate(25deg);
        transition: all 0.6s ease;
      }
      .btn-royal-gold:hover::before { left: 120%; }
      .btn-royal-gold:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(212, 175, 55, 0.55);
      }

      .btn-outline-gold {
        background: transparent;
        color: #f6e27a;
        border: 1px solid var(--gold-primary);
        letter-spacing: 0.06em;
        transition: all 0.3s ease;
      }
      .btn-outline-gold:hover {
        background: rgba(212, 175, 55, 0.12);
        border-color: #f6e27a;
        color: #fff;
        box-shadow: 0 0 15px rgba(212, 175, 55, 0.25);
      }

      /* 3D Rotating Barber Pole */
      .barber-pole-container {
        width: 40px;
        height: 130px;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        filter: drop-shadow(0 0 12px rgba(212, 175, 55, 0.4));
      }
      .barber-pole-cap {
        width: 44px;
        height: 14px;
        background: linear-gradient(180deg, #f6e27a 0%, #aa771c 100%);
        border-radius: 6px 6px 2px 2px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.8), inset 0 1px 1px #fff;
        z-index: 2;
      }
      .barber-pole-cap.bottom {
        border-radius: 2px 2px 6px 6px;
        background: linear-gradient(0deg, #f6e27a 0%, #aa771c 100%);
      }
      .barber-pole-glass {
        width: 30px;
        height: 102px;
        position: relative;
        overflow: hidden;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.05);
        box-shadow: inset 2px 0 4px rgba(255, 255, 255, 0.4), inset -2px 0 4px rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.15);
      }
      .barber-pole-stripes {
        position: absolute;
        top: -100px;
        left: 0;
        width: 100%;
        height: 300px;
        background: repeating-linear-gradient(
          -45deg,
          #e63946,
          #e63946 12px,
          #ffffff 12px,
          #ffffff 24px,
          #1d3557 24px,
          #1d3557 36px,
          #ffffff 36px,
          #ffffff 48px
        );
        animation: spinBarberPole 3.5s linear infinite;
      }
      @keyframes spinBarberPole {
        0% { transform: translateY(0); }
        100% { transform: translateY(96px); }
      }

      /* Animated Scissors Apparatus */
      .scissors-interactive-wrapper {
        position: relative;
        width: 100%;
        max-width: 460px;
        height: 460px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .scissors-orbit-ring {
        position: absolute;
        width: 360px;
        height: 360px;
        border-radius: 50%;
        border: 1px dashed rgba(212, 175, 55, 0.3);
        animation: spinClockwise 30s linear infinite;
      }
      .scissors-orbit-ring-inner {
        position: absolute;
        width: 280px;
        height: 280px;
        border-radius: 50%;
        border: 1px solid rgba(212, 175, 55, 0.2);
        animation: spinCounterClockwise 20s linear infinite;
      }
      @keyframes spinClockwise { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
      @keyframes spinCounterClockwise { from { transform: rotate(360deg); } to { transform: rotate(0deg); } }

      .scissor-blade-top {
        transform-origin: 160px 180px;
        animation: snipTop 1.4s ease-in-out infinite;
      }
      .scissor-blade-bottom {
        transform-origin: 160px 180px;
        animation: snipBottom 1.4s ease-in-out infinite;
      }
      @keyframes snipTop {
        0%, 100% { transform: rotate(0deg); }
        40% { transform: rotate(-16deg); }
        60% { transform: rotate(4deg); }
        75% { transform: rotate(-4deg); }
        85% { transform: rotate(0deg); }
      }
      @keyframes snipBottom {
        0%, 100% { transform: rotate(0deg); }
        40% { transform: rotate(16deg); }
        60% { transform: rotate(-4deg); }
        75% { transform: rotate(4deg); }
        85% { transform: rotate(0deg); }
      }

      /* Before / After Slider */
      .before-after-container {
        position: relative;
        width: 100%;
        max-width: 780px;
        height: 460px;
        overflow: hidden;
        border-radius: 20px;
        user-select: none;
        box-shadow: 0 20px 50px -15px rgba(0, 0, 0, 0.8), 0 0 30px -5px rgba(212, 175, 55, 0.2);
        border: 1px solid rgba(212, 175, 55, 0.3);
      }
      @media (max-width: 640px) {
        .before-after-container { height: 360px; }
      }
      .before-after-img {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        object-fit: cover;
      }
      .before-after-overlay {
        position: absolute;
        top: 0; left: 0;
        height: 100%; width: 50%;
        overflow: hidden;
        z-index: 10;
      }
      .before-after-overlay .before-after-img {
        width: 780px;
        max-width: none;
      }
      @media (max-width: 780px) {
        .before-after-overlay .before-after-img { width: 100vw; }
      }
      .before-after-handle {
        position: absolute;
        top: 0; bottom: 0; left: 50%;
        width: 4px;
        background: var(--gold-gradient);
        z-index: 20;
        cursor: ew-resize;
        transform: translateX(-50%);
        box-shadow: 0 0 15px rgba(212, 175, 55, 0.8);
      }
      .before-after-button {
        position: absolute;
        top: 50%; left: 50%;
        width: 44px; height: 44px;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background: #08090b;
        border: 2px solid #d4af37;
        color: #f6e27a;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.9), 0 0 20px rgba(212, 175, 55, 0.6);
        cursor: ew-resize;
      }
      .before-after-badge {
        position: absolute;
        bottom: 20px;
        padding: 6px 16px;
        border-radius: 30px;
        background: rgba(8, 9, 11, 0.85);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(212, 175, 55, 0.3);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        z-index: 15;
      }
      .before-badge { left: 20px; color: #ff9999; }
      .after-badge { right: 20px; color: #f6e27a; }

      /* Sound Bars */
      .sound-bars { display: flex; align-items: center; gap: 3px; height: 18px; }
      .sound-bar { width: 3px; background-color: #d4af37; border-radius: 2px; height: 4px; transition: height 0.2s ease; }
      .sound-active .sound-bar:nth-child(1) { animation: soundWave 0.8s ease-in-out infinite; }
      .sound-active .sound-bar:nth-child(2) { animation: soundWave 1.1s ease-in-out 0.2s infinite; }
      .sound-active .sound-bar:nth-child(3) { animation: soundWave 0.9s ease-in-out 0.4s infinite; }
      .sound-active .sound-bar:nth-child(4) { animation: soundWave 1.2s ease-in-out 0.1s infinite; }
      @keyframes soundWave { 0%, 100% { height: 4px; } 50% { height: 18px; } }

      /* Tabs & Modal */
      .tab-btn.active {
        background: var(--gold-gradient);
        color: #07080b;
        font-weight: 700;
        border-color: transparent;
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
      }
      .modal-overlay { transition: opacity 0.3s ease, visibility 0.3s ease; }
      .modal-content { transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease; }
      .modal-overlay.hidden-modal,
      .modal-overlay.hidden,
      .hidden-modal {
        display: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
      }
      .modal-overlay.hidden-modal .modal-content,
      .modal-overlay.hidden .modal-content {
        transform: scale(0.95) translateY(20px);
        opacity: 0;
      }
    </style>
  </head>
